{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/deepen.mjs", "${CLAUDE_PLUGIN_DATA}"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/push-guard.mjs"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/test-guard.mjs"], "timeout": 10 }
        ]
      }
    ]
  }
}
